# Unreal Engine 5 .gitignore for Project 9
# Place this file in the same folder as the .uproject file.

# ---------------------------------------------------------------
# Unreal-generated folders (regenerated automatically; never commit)
# ---------------------------------------------------------------
Binaries/
Intermediate/
Saved/
DerivedDataCache/
Build/*
!Build/*/
Build/*/**
!Build/*/PakBlacklist*.txt
!Build/**/*.ico

# Same folders inside plugins
Plugins/**/Binaries/
Plugins/**/Intermediate/

# Baked lighting data (large; rebuilt locally with Build > Build Lighting)
*_BuiltData.uasset

# Asset registry cache (large; Unreal rebuilds it on startup)
CachedAssetRegistry*.bin

# ---------------------------------------------------------------
# IDE and project files (regenerated from the .uproject)
# ---------------------------------------------------------------
.vs/
.vscode/
.idea/
*.sln
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb
*.xcodeproj
*.xcworkspace
*.code-workspace

# ---------------------------------------------------------------
# Compiled code output (only relevant if C++ is added later)
# ---------------------------------------------------------------
*.slo
*.lo
*.o
*.obj
*.gch
*.pch
*.so
*.dylib
*.dll
*.mod
*.lai
*.la
*.a
*.lib
*.exe
*.out
*.app
*.ipa
*.pdb

# ---------------------------------------------------------------
# OS clutter
# ---------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
